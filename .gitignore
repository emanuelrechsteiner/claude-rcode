scheduled-tasks/daily-docs/bin/git-roots.txt

# Third-party skill linked in from outside the repo (2026-08-13).
# skills/composio-cli was a TRACKED symlink -> ../../.agents/skills/composio-cli.
# That target resolves only when the repo IS ~/.claude (the installed house);
# in this working copy and in every clone of the public artifact it is a dead
# link. A symlink pointing outside the repo can never travel with the repo, so
# it is untracked here and re-created per machine instead.
skills/composio-cli

# Publish-pipeline pseudonym list (private, never versioned, never
# published). Maps real private project/location names to neutral public
# placeholders; read by publish-transforms.d/50-pseudonymize.sh and by
# scripts/scrub-check.sh's optional name-leak gate. The whole POINT of this
# file is that it never travels with the repo — if it were tracked, the
# private names it exists to hide would ship inside it. See
# docs/PUBLISHING.md "Pseudonymization" for the format and how to populate
# it locally.
publish-pseudonyms.local.tsv

# Vault (IMP-219, 2026-09-25, plans/vault-by-design-2026-09-25.md). Real
# names/paths/accounts live ONLY here (${CLAUDE_VAULT_DIR:-~/.claude/vault}
# by default, outside this repo entirely) — this entry is defense-in-depth
# in case CLAUDE_VAULT_DIR is ever pointed at a path inside this repo. Never
# versioned: the whole design assumes real values never sit in a tracked
# file, and a tracked vault/ directory would defeat that immediately.
/vault/
