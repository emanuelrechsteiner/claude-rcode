#!/bin/bash
# q2-probe-dispatch-dump.sh — TEMPORARY empirical probe for A6 Q2 (IMP-090 step 0)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  TEMPORARY — expires 2026-07-22. Review/remove after this date REGARDLESS
#     of outcome, per the meta-proposal's explicit rule for this probe: "Until
#     the probe comes back positive, L2 DOES NOT exist" — this file's only job is
#     to produce that verdict, not to become permanent infrastructure.
#
# PreToolUse hook registered with matcher "Task|Agent". Purpose: settle A6 Q2
# empirically — is a Task/Agent dispatch PreToolUse-matchable at all, and does
# `subagent_type` appear as a real tool_input field? The meta-proposal's first
# analysis pass claimed yes; a second literal doc-fetch found no evidence
# either way (contradiction logged in the proposal §1, "second-order rule-making
# events", item 2). Rather than trust either doc-fetch, this hook
# observes the REAL stdin the harness sends — if it ever fires at all.
#
# Behavior: dumps the raw PreToolUse JSON, UNMODIFIED, to
# global-observation/q2-probe.jsonl, one line per invocation, wrapped with a
# capture timestamp. ALWAYS exit 0 — this hook must never affect dispatch
# behavior in any way, it only observes.
#
# Reading the result: an EMPTY (or absent) q2-probe.jsonl after a session that
# is known to have dispatched subagents is itself the Q2 answer ("Task/Agent is
# NOT PreToolUse-matchable with this matcher string") — absence of evidence IS
# evidence here, because the alternative (the hook silently erroring) is ruled
# out by the fail-open design below.
set -u

INPUT=$(cat 2>/dev/null || printf '{}')
LOG="$HOME/.claude/global-observation/q2-probe.jsonl"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
# Wrap the raw input under a capture envelope WITHOUT re-serializing it via jq
# — a jq round-trip could normalize/mask exactly the shape questions (field
# presence, key order) this probe exists to answer. If $INPUT is not valid
# JSON the resulting log line will itself be invalid JSON — that is diagnostic
# signal, not a bug, so it is deliberately not sanitized away.
printf '{"captured_at":"%s","raw":%s}\n' "$TS" "$INPUT" >> "$LOG" 2>/dev/null || true

exit 0
