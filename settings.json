{
  "env": {
    "CLAUDE_KNOWLEDGE_GATE": "off",
    "CLAUDE_KNOWLEDGE_BRIEF": "off",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Agent(*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(> /dev/*)",
      "Bash(nc:*)",
      "Bash(netcat:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/.aws/credentials)",
      "Read(**/.ssh/id_*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets/**)",
      "Read(~/.claude/cockpit/web-*)",
      "Edit(~/.claude/cockpit/web-*)",
      "Bash(cat ~/.claude/cockpit/web-*)",
      "Bash(head ~/.claude/cockpit/web-*)",
      "Bash(tail ~/.claude/cockpit/web-*)",
      "Bash(less ~/.claude/cockpit/web-*)",
      "Bash(grep * ~/.claude/cockpit/web-*)",
      "Bash(tmux capture-pane:*)",
      "Bash(tmux pipe-pane:*)",
      "Bash(tmux save-buffer:*)",
      "Bash(tmux show-buffer:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-context.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/git-identity-check.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/dependency-check.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/sandbox-guard.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/git-remote-check.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/routine-liveness-check.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/security-findings-check.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/knowledge-mirror-refresh.sh",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-unsafe.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governing-path-guard.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/git-bypass-guard.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/git-state-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/excessive-agency-gate.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/web-fetch-safety-gate.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Grep|Glob|Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cockpit-secret-guard.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/web-fetch-safety-gate.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/dispatch-capture.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/knowledge-inject.sh --dispatch",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/goal-track.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/mcp-agency-gate.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/web-fetch-safety-gate.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__serena__.*|mcp__plugin_serena_serena__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/serena-write-gate.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/parallel-lock-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/config-protection.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/file-protection.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governing-path-guard.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/security-audit.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/vault-write-gate.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/governing-path-guard.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/vault-write-gate.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__serena__.*|mcp__plugin_serena_serena__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/serena-post-tool.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-format.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/post-edit-validate.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/observation-capture.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/goal-track.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-end-check.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-batched-checks.sh",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/self-critique-log.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-handoff-write.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/config-drift-check.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/background-agent-check.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/goal-stop.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/knowledge-inject.sh --subagent-start",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/goal-track.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/subagent-lock-release.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/subagent-watchdog.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/goal-track.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/postbash-failure-recovery.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notification-tts.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/background-agent-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/knowledge-inject.sh --prompt",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/goal-prompt.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "firebase@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "firecrawl@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": false,
    "pixel-plugin@pixel-plugin": false,
    "vercel@claude-plugins-official": false,
    "design@synced": false,
    "marketing@synced": false,
    "finance@synced": false,
    "brand-voice@synced": false
  },
  "syncClaudeAiSkills": false,
  "extraKnownMarketplaces": {
    "pixel-plugin": {
      "source": {
        "source": "github",
        "repo": "willibrandon/pixel-plugin"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowUnixSockets": [
        "~/.ssh/agent-socket",
        "/var/run/docker.sock"
      ],
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "git",
      "docker",
      "npm",
      "node"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "verbose": true,
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "low"
    },
    "claude-opus-5-5": {
      "effortLevel": "low"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "high"
    }
  },
  "switchModelsOnFlag": true
}
