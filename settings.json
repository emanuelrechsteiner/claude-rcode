{
  "env": {
    "MAX_THINKING_TOKENS": "30000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "90",
    "CLAUDE_CONTROLLER_GATE_MODE": "note",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Agent(*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf ~/*:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(> /dev/*:*)",
      "Bash(nc:*)",
      "Bash(netcat:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/.aws/credentials)",
      "Read(**/.ssh/id_*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets/**)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo '🚀 Claude Code session started - $(date)'"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-context.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/git-identity-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/sandbox-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/git-remote-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/routine-liveness-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/security-findings-check.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-unsafe.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/git-state-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/git-identity-enforce.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/excessive-agency-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/web-fetch-safety-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/controller-first-mutation-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/read-tool-preference-advisory.sh"
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/web-fetch-safety-gate.sh"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/dispatch-capture.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/dispatch-specialist-check.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/mcp-agency-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/web-fetch-safety-gate.sh"
          }
        ]
      },
      {
        "matcher": "mcp__serena__.*|mcp__plugin_serena_serena__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/serena-write-gate.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/parallel-lock-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/gateguard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pretool-auto-read.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/config-protection.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/file-protection.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/security-audit.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/vault-write-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/controller-first-mutation-gate.sh"
          },
          {
            "type": "command",
            "command": "echo '📝 File modification detected - remember to commit within 60 minutes'"
          },
          {
            "type": "command",
            "command": "if [ -d .rcode ] && [ -f .rcode/scope-manifest.json ]; then BRANCH=$(git branch --show-current 2>/dev/null); if echo \"$BRANCH\" | grep -q 'issue-'; then echo 'R.Code: Scope guard active. Ensure changes are within issue scope.'; fi; fi"
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/vault-write-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__serena__.*|mcp__plugin_serena_serena__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/serena-post-tool.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-format.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/post-edit-validate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/observation-capture.sh"
          },
          {
            "type": "command",
            "command": "if [ -d .rcode ]; then echo 'R.Code: Remember to update PROJECT-STATUS.md if this completes an issue.'; fi"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/posttool-track-read.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-end-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-batched-checks.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/self-critique-log.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-handoff-write.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/config-drift-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/background-agent-check.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/subagent-lock-release.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/subagent-watchdog.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/controller-first-subagent-flag.sh"
          },
          {
            "type": "command",
            "command": "echo '✅ Sub-agent completed task'"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/postbash-failure-recovery.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notification-tts.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/parallel-analyze-prompt.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/controller-first-prompt-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/background-agent-check.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "firebase@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "pixel-plugin@pixel-plugin": true,
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "pixel-plugin": {
      "source": {
        "source": "github",
        "repo": "willibrandon/pixel-plugin"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowUnixSockets": [
        "~/.ssh/agent-socket",
        "/var/run/docker.sock"
      ],
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "git",
      "docker",
      "npm",
      "node"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "verbose": true,
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  }
}
