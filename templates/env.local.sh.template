# Maschinenspezifische Pfade fuer dieses Claude-Code-Framework.
#
# NIE versionieren (siehe .gitignore: *.local.sh) — kein echter Pfad, Konto-
# oder Projektname gehoert in eine versionierte Datei dieses Repos (IMP-219,
# vault-by-design). Diese Werte leben ausschliesslich hier, im bewohnten Haus.
#
# Einrichtung:
#   cp templates/env.local.sh.template ~/.claude/env.local.sh
#   chmod 600 ~/.claude/env.local.sh
#   # dann die Platzhalter unten durch echte Werte ersetzen
#
# Gelesen von Skripten/Hooks, die eine Maschinenwurzel brauchen (u.a.
# scripts/deploy-to-live.sh) — NUR wenn die jeweilige Umgebungsvariable NICHT
# bereits gesetzt ist (bereits gesetzte Variablen haben Vorrang, z.B. in
# Testsuiten). Fehlt sowohl die Variable als auch diese Datei, brechen die
# Skripte fail-loud ab (rules/fail-loud.md) — sie raten nie einen Pfad.

# Pflicht auf dem Wartungsrechner: absoluter Pfad zur Arbeitskopie (Bauhof)
# dieses Repos, AUSSERHALB von ~/.claude.
export CLAUDE_BAUHOF_ROOT="/absoluter/pfad/zur/arbeitskopie"

# Optional: die Elternwurzel, die sowohl den Bauhof (claude-code-config) als
# auch das Schwesterprojekt cockpit/ enthaelt. Default: das Elternverzeichnis
# von CLAUDE_BAUHOF_ROOT — meist reicht das, ohne diese Zeile zu aendern.
export CLAUDE_WORKSHOP_ROOT="${CLAUDE_WORKSHOP_ROOT:-$(dirname "${CLAUDE_BAUHOF_ROOT}")}"

# Optional: absoluter Pfad zur projektuebergreifenden Registry (JSONL), falls
# meta-intelligence-artige Skills sie nutzen. Ohne diese Variable melden
# solche Skills schlicht "Registry nicht erreichbar" (fail-loud, kein Absturz).
export CLAUDE_PROJECT_REGISTRY="/absoluter/pfad/projects.jsonl"

# Optional: zusaetzliche, durch ":" getrennte Suchwurzeln fuer den Commit-
# Prosa-Scan der daily-docs-Routine (git-log ueber Repos ausserhalb von
# $HOME/Cowork und $HOME/.claude, siehe scheduled-tasks/daily-docs/SKILL.md).
# Ersetzt eine frueher fest codierte Verzeichnistiefe zwischen Bauhof und
# einer Elternebene (IMP-219, korrigiert 2026-09-25 — das war eine Annahme
# ueber die Ordnerstruktur eines einzelnen Rechners im versionierten Code).
# Fehlt die Variable, durchsucht die Routine nur die beiden $HOME-Wurzeln
# (WARN pro fehlender Wurzel, kein Abbruch).
export CLAUDE_EXTRA_SEARCH_ROOTS="/absoluter/pfad/eins:/absoluter/pfad/zwei"

# Optional: Ort des Tresors (Tokens statt Klartext fuer echte Namen/Pfade,
# IMP-219). Der Default reicht fuer die meisten Faelle.
export CLAUDE_VAULT_DIR="${HOME}/.claude/vault"

# Optional: Zeitzone fuer die daily-docs-Tageszaehlung (logbook-count.sh).
# Ohne diese Variable wird die Systemzeitzone verwendet (readlink /etc/localtime);
# nur setzen, wenn die Routine eine ANDERE Zeitzone als die des Rechners zaehlen soll.
# IANA-Name (Region/Stadt-Form, z.B. wie in /usr/share/zoneinfo aufgelistet).
# Fehlen BEIDE (diese Variable UND die Systemzeitzone), bricht logbook-count.sh
# mit ABORT(6) ab (fail-loud).
export CLAUDE_LOGBOOK_TZ="Region/Stadt"

# Pflicht fuer die daily-docs- und weekly-improve-Routinen: die Notion-Seiten-ID
# der "Claude Code Logbuch"-Parent-Page. Fehlt sie, melden beide Routinen
# "nicht konfiguriert" (status:partial) und schreiben nichts nach Notion — das
# lokale Markdown-Logbuch (§A) entsteht trotzdem (fail-loud, kein Absturz).
export CLAUDE_LOGBOOK_NOTION_PAGE_ID="<notion-page-id>"
