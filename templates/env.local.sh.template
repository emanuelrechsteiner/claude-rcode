# Machine-specific paths for this Claude Code framework.
#
# NEVER version this (see .gitignore: *.local.sh) — no real path, account,
# or project name belongs in a versioned file of this repo (IMP-219,
# vault-by-design). These values live exclusively here, in the live install.
#
# Setup:
#   cp templates/env.local.sh.template ~/.claude/env.local.sh
#   chmod 600 ~/.claude/env.local.sh
#   # then replace the placeholders below with real values
#
# Read by scripts/hooks that need a machine root (among others
# scripts/deploy-to-live.sh) — ONLY when the respective environment variable
# is NOT already set (an already-set variable takes precedence, e.g. in
# test suites). If both the variable and this file are missing, the
# scripts abort fail-loud (rules/fail-loud.md) — they never guess a path.

# Mandatory on the maintenance machine: absolute path to the working copy
# (workshop) of this repo, OUTSIDE of ~/.claude.
export CLAUDE_BAUHOF_ROOT="/absolute/path/to/the/working/copy"

# Optional: the parent root that contains both the workshop (claude-code-config)
# and the sibling project cockpit/. Default: the parent directory of
# CLAUDE_BAUHOF_ROOT — usually enough without changing this line.
export CLAUDE_WORKSHOP_ROOT="${CLAUDE_WORKSHOP_ROOT:-$(dirname "${CLAUDE_BAUHOF_ROOT}")}"

# Optional: absolute path to the cross-project registry (JSONL), if
# meta-intelligence-style skills use it. Without this variable, such skills
# simply report "registry not reachable" (fail-loud, no crash).
export CLAUDE_PROJECT_REGISTRY="/absolute/path/projects.jsonl"

# Optional: additional, colon-separated search roots for the daily-docs
# routine's commit-prose scan (git log over repos outside of
# $HOME/Cowork and $HOME/.claude, see scheduled-tasks/daily-docs/SKILL.md).
# Replaces a formerly hardcoded directory depth between the workshop and
# a parent level (IMP-219, corrected 2026-09-25 — that was an assumption
# about one machine's folder structure baked into versioned code).
# If the variable is missing, the routine only searches the two $HOME
# roots (WARNs per missing root, no abort).
export CLAUDE_EXTRA_SEARCH_ROOTS="/absolute/path/one:/absolute/path/two"

# Optional: location of the vault (tokens instead of plaintext for real
# names/paths, IMP-219). The default is enough for most cases.
export CLAUDE_VAULT_DIR="${HOME}/.claude/vault"

# Optional: timezone for the daily-docs day count (logbook-count.sh).
# Without this variable, the system timezone is used (readlink /etc/localtime);
# only set it if the routine should count in a DIFFERENT timezone than the machine's.
# IANA name (Region/City form, e.g. as listed in /usr/share/zoneinfo).
# If BOTH are missing (this variable AND the system timezone), logbook-count.sh
# aborts with ABORT(6) (fail-loud).
export CLAUDE_LOGBOOK_TZ="Region/City"

# Mandatory for the daily-docs and weekly-improve routines: the Notion page id
# of the "Claude Code Logbook" parent page. If missing, both routines report
# "not configured" (status:partial) and write nothing to Notion — the
# local markdown logbook (§A) is still produced (fail-loud, no crash).
export CLAUDE_LOGBOOK_NOTION_PAGE_ID="<notion-page-id>"

# Optional: language of the local daily-docs logbook (~/.claude/logbook/*.md)
# that daily-docs/SKILL.md writes — this is the OWNER's own reading language,
# distinct from the framework's own English-only prompts/scripts (the prompt
# stays English regardless of this setting). Accepted values: "en" (default
# when unset) or "de". Read by the daily-docs routine's agent (headings, see
# scheduled-tasks/daily-docs/SKILL.md § Output) and by bin/logbook-count.sh
# (the "not capturable" sentences it emits). Set "de" for German logbooks.
export CLAUDE_DAILY_DOCS_LANG="en"

# Optional: the knowledge folder that scripts/knowledge-mirror.sh fills with
# read-only COPIES of the distilled knowledge layer (logbook, per-project
# memory, meta-proposals, tracked rules, a rendered ledger index) so it can be
# opened in Obsidian without Obsidian ever writing into a file the framework
# reads (IMP-248). Checked by the script (fail-loud, exit 1):
#   * absolute path; NO default — unset means the script refuses to run;
#   * OUTSIDE ~/.claude and OUTSIDE the workshop (CLAUDE_BAUHOF_ROOT), and
#     not a parent of either;
#   * not named "vault": that word is the PII pseudonym store above.
# NOT checked by the script — your responsibility: never put it under a
# synced folder (iCloud Drive, Dropbox, Obsidian Sync, ...). The mirror holds
# memory files and private project names.
# The script owns <dir>/mirror/ and overwrites it on each run; <dir>/notes/ is
# yours and is never touched.
export CLAUDE_KNOWLEDGE_DIR="/absolute/path/to/knowledge-folder"
