# Serena — the parts of this setup that CANNOT be versioned
#
# WARNING: This file is a TEMPLATE, not a live config.
#     Target: ~/.serena/serena_config.yml  (lives OUTSIDE this repo and
#     therefore cannot be versioned along with it — Serena writes the file
#     itself and creates its own fields like `projects:` on startup).
#
# When setting up on a new machine: start Serena once (creates the file),
# then COPY OVER the two blocks documented below. Without them the repo does
# NOT reproduce the setup — the rules and hooks come along, the safeguard
# does not.
#
# Background + measurements: IMP-104/105 in global-observation/improvement-ledger.json
# Rule doc: rules/mcp-tool-usage.md -> "## Serena" (maintenance knowledge: PART 3 below)
#
# -----------------------------------------------------------------------------
# PART 1 — MCP registration (NOT in this file, but in ~/.claude.json)
# -----------------------------------------------------------------------------
#
# Serena MUST start with `--context claude-code`. The plugin
# (serena@claude-plugins-official) starts WITHOUT this flag and thereby falls
# back to the default context `desktop-app`.
#
# WARNING — CORRECTION 2026-08-15 — this used to state something WRONG:
#   "that's why the plugin is deliberately set to `false` in settings.json".
# In fact settings.json had `"serena@claude-plugins-official": true`.
# The intent was documented, the implementation was missing — and nobody
# noticed, because this very line claimed it was already done. Consequence
# in practice:
#   * TWO Serena processes per session (measured: PID 82804 with the context,
#     PID 82495 without), hence also two dashboard windows on startup
#   * the plugin copy exposed 28 tools instead of 22 — exactly the 6 that the
#     claude-code context excludes, including execute_shell_command
# `serena-write-gate.sh` demonstrably refused `execute_shell_command`
# ("shell execution must go through the Bash tool and its gates"), so the
# lock held — the door was nonetheless built in.
# Fixed: `claude plugin uninstall serena@claude-plugins-official` AND removing
# the enabledPlugins entry from settings.json. A bare `false` is not enough
# as long as nobody checks whether it's actually there.
#
#   claude mcp add serena --scope user -- \
#     uvx --from git+https://github.com/oraios/serena \
#     serena start-mcp-server --context claude-code --project .
#
# --project . (NEW 2026-08-15) — replaces the rule documented here earlier,
# "NO --project flag". Why the change:
#   Claude Code starts the MCP server with cwd = the project directory of the
#   given session (verified via lsof against running processes: two sessions,
#   two different cwds). Serena resolves a relative path against exactly this
#   cwd (ProjectType.convert in cli.py -> Path(value).resolve()). So the dot
#   does NOT hardcode any fixed path — every session activates its own
#   project.
#   Evidence in the log: "Activating claude-code-config at /Volumes/...".
#
# THE COST OF THIS DECISION (not to be glossed over): the claude-code context
# sets `single_project: true`. With a fixed project, Serena therefore
# disables TWO tools (log: "SingleProjectExclusions excluded 2 tools"):
#   activate_project  — the project can no longer be switched within a session
#   get_current_config — see VERIFICATION below, the old check path goes away with it
# Relevant only if a session needs to symbolically work on TWO registered
# projects at once (e.g. workshop + live install). In exchange, manual
# activation at every session start goes away — the reason for the change.
#
# Rollback (one line): remove the flag pair "--project", "." from ~/.claude.json.
# An alternative not implemented, which would have both: its own context via
#   serena context create --from-internal claude-code
# with `single_project: false` and still `--project .`. Cost there: the
# context prompt is maintained and evolved upstream; a copy of your own forks
# it and silently goes stale.
#
# What `--context claude-code` does compared to `desktop-app`:
#   1. excludes 6 tools that duplicate native tools:
#      read_file, create_text_file, execute_shell_command, find_file, list_dir,
#      search_for_pattern
#      -> execute_shell_command is the security-relevant one: the hook matchers
#         and permissions.deny bind to the tool NAME "Bash". No mcp__* name
#         matches. This tool was therefore an open path around
#         guard-unsafe.sh, excessive-agency-gate.sh, and
#         deny: Bash(rm -rf ~/*). mcp-agency-gate.sh does NOT catch it
#         (not in its ESCALATE_RE).
#   2. structured_tool_output: false — a documented Claude Code bug (doesn't
#      unpack structured outputs -> massive escaping -> wasted tokens)
#   3. corrects the system prompt (desktop-app claims the user sits in front
#      of a chat interface separate from the code — simply wrong for Claude
#      Code)
#
# Verification after setup (as of 2026-08-15):
#   get_current_config no longer exists with --project (SingleProjectExclusions).
#   Instead, spawn a fresh server and check the build log:
#     cd <project> && uvx --from git+https://github.com/oraios/serena \
#       serena start-mcp-server --context claude-code --project . </dev/null
#   Expected in the log under ~/.serena/logs/<date>/:
#     "Activating <project-name> at <path>"           <- auto-activation works
#     "Number of exposed tools: 21"                   <- the context is applied
#     open_dashboard IN the tool list                  <- the window does NOT open by itself
#
# -----------------------------------------------------------------------------
# PART 2 — the two blocks for ~/.serena/serena_config.yml
# -----------------------------------------------------------------------------

# --- Block A: Serena write tools behind the delegating gate --------------------
#
# HISTORY: Until 2026-08-05, ALL 11 write tools were disabled here
# (3:0 review verdict, IMP-104) — the hook matchers in settings.json bind to
# tool NAMES ("Write|Edit"), no mcp__serena__* name matches, so Serena edits
# bypassed all 10 Write|Edit hooks (including security-audit and
# observation-capture). The review rejected an adapter, because the hooks are
# fail-open and a half-built adapter would have reported GREEN without
# actually checking anything.
#
# SUPERSEDED (IMP-130, 2026-08-05, docs/adr/0001): there is now a delegating,
# FAIL-CLOSED gate:
#   ~/.claude/hooks/serena-write-gate.sh   (PreToolUse,  matcher mcp__serena__.*)
#   ~/.claude/hooks/serena-post-tool.sh    (PostToolUse, same matcher)
# It translates every Serena write call into the (file_path, new_string) shape
# and calls the SAME checker scripts (parallel-lock-check, file-protection,
# security-audit, config-protection; afterward auto-format, post-edit-validate,
# observation-capture). Unknown tool / missing contract parameter /
# missing checker -> DENY, never wave through. This answers the review's
# fail-open objection instead of ignoring it.
# Regression: hooks/tests/serena-gate-regression.sh (35 cases, incl.
# secret-through-the-Serena-door -> block).
#
# Special cases:
#   rename_symbol / safe_delete_symbol  -> the gate raises a CONFIRMATION (ask):
#     the LSP writes N reference files, and the single-file checkers only see
#     the definition file. No silent wave-through of the rest.
#   write_memory "global/..." or path segments in the name -> DENY (path escape).
#
# ACTIVATION ORDER (mandatory): first claude-deploy (gate into the live
# install), then a NEW session, and ONLY THEN shorten this excluded_tools
# list. In the reverse order, the write tools would run unprotected for one
# session.
excluded_tools:
  # replace_in_files writes MULTIPLE files in one call and carries no
  # mappable single path in its input — stays disabled (the gate would
  # refuse it anyway; belt and suspenders).
  - replace_in_files

# --- Block B: keep worktree copies globally out of the symbol index ------------
#
# WHY GLOBAL: `.claude/worktrees/` is a Claude Code CONVENTION, not something
# specific to one project — every project can create worktrees there
# (evidenced: proj-1df43a, proj-1b199b, a shop project under acct-e26b40). A
# project-local exclusion would have solved 1 of 16 projects.
#
# THE PROBLEM: worktrees contain complete, often DIVERGENT copies of the
# source code. In proj-1df43a, find_symbol("lintLens") returned THREE hits —
# one of them a stale version (217 lines instead of 244). An edit could have
# landed in the wrong copy on a foreign branch: invisible to the active
# branch, tests there still green. 872 stale source duplicates against 458
# real files = ~65% of the index was garbage.
#
# WHY ignore_all_files_in_gitignore DOES NOT CATCH THIS: `.claude/worktrees/`
# is excluded via `.git/info/exclude`, not via a `.gitignore` FILE. Serena
# parses .gitignore files; `.git/info/exclude` is not one. The reliable test
# is always `git check-ignore -v <path>` — it resolves all 4 ignore sources.
#
# Serena merges global and project-local ignored_paths ADDITIVELY.
# Project-specific exclusions (e.g. large docs/artifacts folders) still
# belong in .serena/project.yml.
ignored_paths:
  - ".claude/worktrees"

# --- Block C: don't bring the dashboard to the foreground uninvited (NEW 2026-08-15) ---
#
# Serena starts a web dashboard per instance and, with the default `true`,
# used to pop open a browser window on EVERY start that pushed itself to the
# foreground. With the duplicate install in place at the time, that was two
# windows per session; measured on 2026-08-15, eight dashboards were
# listening simultaneously on 24282-24289, plus a tray-manager process that
# had been running continuously since August 8th.
#
# The dashboard remains fully usable — it just no longer forces itself on you:
#   * reachable at http://localhost:24282/dashboard/ (with multiple instances,
#     ascending: 24283, 24284, …)
#   * with `false`, Serena additionally exposes the `open_dashboard` tool; an
#     "open the dashboard" in chat is then enough.
# This exact tool is also the proof that the setting takes effect: with
# `true` it's missing from the tool list, with `false` it's present (verified
# in the log).
web_dashboard_open_on_launch: false

