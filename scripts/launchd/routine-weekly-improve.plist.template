<?xml version="1.0" encoding="UTF-8"?>
<!--
    IMP-135 (2026-08-22; genericized IMP-219, 2026-09-25). Replaces the
    unversioned Cloud-scheduled binding that broke silently for 20 days
    after a 2026-08-02 directory rename. Fires routine-run.sh
    weekly-improve at 22:06 LOCAL time every Sunday (Weekday 0 = Sunday in
    launchd's StartCalendarInterval; launchd does not do UTC conversion —
    always local wall-clock).

    This is a TEMPLATE, not an installed plist — __HOME__ and __LABEL__ are
    placeholders rendered by scripts/install-routine-timers.sh at install
    time (real $HOME, generic label com.claude-code.routine-weekly-improve).
    Not installed by writing this file. Install via:
      bash ~/.claude/scripts/install-routine-timers.sh
    (only meaningful AFTER claude-deploy has copied scripts/routine-run.sh
    into ~/.claude/scripts/ — see that script's own precondition check.)
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/.claude/scripts/routine-run.sh</string>
        <string>weekly-improve</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>22</integer>
        <key>Minute</key><integer>6</integer>
    </dict>

    <!-- Run once after wake if the Mac was asleep at Sunday 22:06; don't wake it for this. -->
    <key>StartCalendarIntervalRunsWhileSleeping</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude/global-observation/launchd-weekly-improve.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/global-observation/launchd-weekly-improve.err.log</string>

    <!-- Weekly fixed-time job, not a daemon — never restart on exit/failure. -->
    <key>KeepAlive</key>
    <false/>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
